<Window x:Class="HomeworkBoard.Views.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeworkBoard.ViewModels"
        Title="编辑作业"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BrushWindowBg}"
            BorderBrush="#3A3A3C"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="0">
            <!-- 标题栏 -->
            <Border Padding="18,14,14,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="添加作业"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText"
                                   Text=""
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource TitleBarCloseButton}"
                            Content="✕"
                            Click="BtnCancel_Click"
                            ToolTip="取消" />
                </Grid>
            </Border>

            <!-- 内容区 -->
            <StackPanel Margin="18,0,18,0">

                <!-- 模板快选 -->
                <TextBlock Text="快速模板"
                           Foreground="{StaticResource BrushTextTertiary}"
                           FontSize="12"
                           Margin="0,0,0,6" />
                <ItemsControl x:Name="TemplateList" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TemplateChip}"
                                    Content="{Binding Label}"
                                    Tag="{Binding}"
                                    Click="TemplateChip_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 手动输入 -->
                <TextBlock Text="作业内容"
                           Foreground="{StaticResource BrushTextTertiary}"
                           FontSize="12"
                           Margin="0,12,0,6" />
                <TextBox x:Name="ContentBox"
                         Style="{StaticResource DarkTextBox}"
                         FontSize="16"
                         MinHeight="70"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="ContentBox_KeyDown" />

                <TextBlock Text="提示：选模板后光标会自动落在需要填数字的位置，直接打字即可。回车确认，Esc 取消。"
                           Foreground="{StaticResource BrushTextTertiary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- 按钮区 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="18,18,18,18">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="取消"
                        Click="BtnCancel_Click"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}"
                        Content="确定"
                        Click="BtnOk_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
