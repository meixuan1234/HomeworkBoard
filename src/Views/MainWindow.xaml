<Window x:Class="HomeworkBoard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeworkBoard.ViewModels"
        Title="作业可视化悬浮窗"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Width="380"
        Height="720"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MinWidth="280"
        MinHeight="180"
        MaxWidth="1600"
        MaxHeight="{Binding MaxWindowHeight, Mode=OneWay}">

        <!-- ================================================================================
             缩放方案说明（重要）
             
             本窗口同时需要「无边框」与「可拖边框缩放」，这两者在 WPF 下天然冲突：
             WindowStyle="None" + AllowsTransparency="True" 在 Win32 层面创建的是
             **分层窗口（WS_EX_LAYERED）**。分层窗口没有非客户区（NC area），
             于是系统原生的 8 个边框缩放热区全部消失。
             
             后果：ResizeMode="CanResize" 形同虚设，
             WindowChrome.ResizeBorderThickness 也不会生效（它只在有 NC 区时被系统采用），
             自绘握把直接改 Width/Height 同样会被分层窗口的渲染管线吞掉
             （这正是上一版"宽度改不动"的原因）。
             
             因此缩放改由代码后置在根容器 RootLayout 上自绘 8 个透明热区，
             热区按下时发送 WM_SYSCOMMAND + SC_SIZE + 方向码，
             交给 Windows 内建的缩放循环处理（见 MainWindow.xaml.cs 的 InstallResizeHotspots）。
             
             注意：不要再加 WindowChrome —— 它与 AllowsTransparency="True" 组合有已知冲突
             （启动白屏 / 窗体向外扩），且对分层窗口并不产生有效的缩放热区。
             ================================================================================ -->

    <!-- ================================================================================
         主容器
         - 外层 Border 负责圆角 + 边框 + 阴影（AllowsTransparency 下才有真实圆角）
         - Opacity 绑定到视图模型的透明度设置（70%—95%）
         ================================================================================ -->
    <Border x:Name="RootBorder"
            Background="{StaticResource BrushWindowBg}"
            BorderBrush="#3A3A3C"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="{Binding OpacityValue, Mode=OneWay}">

        <Border.Effect>
            <!-- 轻微投影，让悬浮窗与桌面有层次。不使用模糊动画，静态阴影开销可忽略 -->
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.5"
                              Color="#000000" />
        </Border.Effect>

        <Grid x:Name="RootLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: 标题栏（可拖拽） -->
                <RowDefinition Height="Auto" />   <!-- 1: 工具条 -->
                <RowDefinition Height="*" />      <!-- 2: 内容区（网格卡片） -->
                <RowDefinition Height="Auto" />   <!-- 3: 状态栏 -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 第 0 行：自绘标题栏
                 作用：① 显示日期与条目统计；② 鼠标按住 / 手指按住可拖动窗口；③ 提供各种开关。
                 注意：鼠标与触摸两套事件同时挂载，由代码后置分别处理，互不冲突。
                 ============================================================ -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="Transparent"
                    Padding="14,6,10,5"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    TouchDown="TitleBar_TouchDown"
                    TouchMove="TitleBar_TouchMove"
                    TouchUp="TitleBar_TouchUp"
                    TouchLeave="TitleBar_TouchUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧信息块：日期 + 拖动提示。
                         垂直对齐必须是 Center：右侧按钮栈高 34px（TitleBarButton 的 MinHeight），
                         若左侧取 Top 就会与按钮顶端齐平，导致文字下方留出一大块空白，
                         整条标题栏被撑到约 70px —— 这是"标题栏过高"的根因。 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDateText}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DragHintText"
                                   Text="今日作业 · 按住空白处可拖动本窗口"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   FontSize="11"
                                   LineHeight="13"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 右：置顶 / 设置 / 最小化 / 关闭。
                         标题栏总高由这排按钮决定（34px），所以这里也不再用 Top 对齐，
                         改为 Center，让按钮与左侧文字块在视觉上居中对齐。 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnTopmost"
                                Style="{StaticResource TitleBarButton}"
                                Content="📌"
                                Click="BtnTopmost_Click"
                                ToolTip="切换置顶（当前状态见按钮高亮）" />
                        <Button x:Name="BtnSettings"
                                Style="{StaticResource TitleBarButton}"
                                Content="⚙"
                                Click="BtnSettings_Click"
                                ToolTip="设置：透明度、字号、列宽、科目与模板" />
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource TitleBarButton}"
                                Content="─"
                                Click="BtnMinimize_Click"
                                ToolTip="最小化" />
                        <Button x:Name="BtnClose"
                                Style="{StaticResource TitleBarCloseButton}"
                                Content="✕"
                                Click="BtnClose_Click"
                                ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 第 1 行：工具条
                 作用：显示条目统计、提供「重新载入」「立即保存」「全部展开/收起」
                 ============================================================ -->
            <Border Grid.Row="1"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="0,1,0,1"
                    Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextTertiary}"
                               FontSize="12">
                        <Run Text="共 " />
                        <Run Text="{Binding TodayCount, Mode=OneWay}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" />
                        <Run Text=" 项 · " />
                        <Run Text="{Binding DoneCount, Mode=OneWay}" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" />
                        <Run Text=" 项已完成" />
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostIconButton}"
                                Content="↻"
                                Click="BtnReload_Click"
                                ToolTip="重新载入 JSON 配置文件（用记事本改完后点这里生效）" />
                        <Button Style="{StaticResource GhostIconButton}"
                                Content="💾"
                                Click="BtnSaveNow_Click"
                                ToolTip="立即保存到 JSON 文件" />
                        <Button Style="{StaticResource GhostIconButton}"
                                Content="📂"
                                Click="BtnOpenFolder_Click"
                                ToolTip="打开程序所在文件夹（可直接编辑 JSON）" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 第 2 行：内容区
                 网格横向铺排：一行从左往右放卡片，放不下就换到下一行。
                 （第 8 轮需求：原来「纵向填满一列再往左另起一列」已废弃）
                 
                 实现方式：外层 ItemsControl（行容器）用 Vertical StackPanel 竖着排行，
                 内层 ItemsControl（卡片容器）用 Horizontal StackPanel 横着排卡片。
                 之所以不用 WrapPanel 一步到位：WrapPanel 换行是按渲染宽度动态决定的，
                 而本程序的列宽来自配置（columnWidth），需要精确控制「一行放几个」，
                 且要让换行点与 ViewModel 的估算一致，否则拖拽排序时坐标会错位。
                 ============================================================ -->
            <Grid Grid.Row="2">
                <!-- 有作业时的网格视图 -->
                <!-- PanningMode / PanningDeceleration 是触摸屏惯性滚动的关键：
                     不开的话手指滑动只能靠拖动滚动条，教室里很难操作。 -->
                <ScrollViewer x:Name="ContentScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.001"
                              PanningRatio="1.5"
                              Padding="10,10,10,10"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  MinWidth="240">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 行：竖着排，一行接一行 -->
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RowViewModel}">
                                <!-- 一行：横向堆叠若干科目卡片。
                                     单张卡片宽度取自 Window.DataContext（即 MainViewModel）的 ColumnWidth。 -->
                                <ItemsControl ItemsSource="{Binding Cards}"
                                              HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- 卡片：横着排，排不下由 ViewModel 提前分行 -->
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SubjectCardViewModel}">
                                            <!-- ============ 单个科目卡片 ============
                                                 两种状态（由 HasItems / IsEmpty 驱动）：
                                                 - 有作业：正常配色，列出条目
                                                 - 无作业：淡化占位，色条变暗、背景更暗、标题转灰，＋ 仍可点
                                                 空科目常驻的意义：位置固定，教室大屏上学生能形成肌肉记忆。 -->
                                            <Border x:Name="CardBorder"
                                                    Background="{StaticResource BrushCardBg}"
                                                    CornerRadius="10"
                                                    Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,10,10"
                                                    Padding="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- 左侧色条：一眼分辨科目 -->
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 科目主题色条。空科目时用 BarColorHex（暗灰） -->
                                                    <Border x:Name="ColorBar"
                                                            Grid.Column="0"
                                                            Background="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                                                            CornerRadius="10,0,0,10" />

                                                    <!-- x:Name 供触发器收紧内边距用：
                                                         空卡片不需要上下大留白，折叠后更紧凑 -->
                                                    <StackPanel x:Name="CardContent" Grid.Column="1" Margin="12,10,10,12">
                                                        <!-- 卡片标题行：排序钮 + 科目名 + 条目数 + 操作按钮。
                                                             排序采用「⬆ / ⬇ 按钮」而非长按拖拽：
                                                             长按手势在触屏上会与 ScrollViewer 的惯性滚动抢触摸事件
                                                             （ScrollViewer 先一步把 TouchDown 吃掉去做滚动），
                                                             实测不可靠。按钮方案无歧义、无需学习成本，也更适合触屏。 -->
                                                        <Grid x:Name="CardTitleRow"
                                                              Background="Transparent"
                                                              MinHeight="40">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 排序按钮：上移 / 下移。
                                                                 两个按钮共占一列，纵向紧凑排列，
                                                                 每格 26x22 —— 略小于常规 34px 触屏标准，
                                                                 因为卡片本身密集，且排序是低频操作，
                                                                 误触代价低（再点回来即可）。 -->
                                                            <StackPanel x:Name="CardSortPanel"
                                                                        Grid.Column="0"
                                                                        Orientation="Vertical"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,4,0">
                                                                <Button Content="▲"
                                                                        Width="26" Height="22"
                                                                        Padding="0"
                                                                        Tag="{Binding}"
                                                                        Click="BtnCardUp_Click"
                                                                        ToolTip="把这张卡片往前移一位"
                                                                        FontSize="9"
                                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand" />
                                                                <Button Content="▼"
                                                                        Width="26" Height="22"
                                                                        Padding="0"
                                                                        Tag="{Binding}"
                                                                        Click="BtnCardDown_Click"
                                                                        ToolTip="把这张卡片往后移一位"
                                                                        FontSize="9"
                                                                        Foreground="{StaticResource BrushTextSecondary}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <!-- 标题颜色随状态切换（有作业=科目色，无作业=灰），
                                                                     在 ViewModel 的 TitleColorHex 里算好，避免 XAML 里做复杂判断 -->
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="{Binding TitleColorHex, Converter={StaticResource HexToBrush}}"
                                                                           FontSize="{Binding DataContext.TitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center" />
                                                                <Border Background="#3A3A3C"
                                                                        CornerRadius="7"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <!-- 空科目时隐藏角标（"0 项"没有信息量） -->
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding CountText}"
                                                                               Foreground="{StaticResource BrushTextTertiary}"
                                                                               FontSize="11" />
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <Button Style="{StaticResource GhostIconButton}"
                                                                        Content="＋"
                                                                        Tag="{Binding}"
                                                                        Click="BtnAddItem_Click"
                                                                        ToolTip="给本科目添加一条作业" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 作业条目列表 -->
                                                        <ItemsControl x:Name="ItemsList"
                                                                      ItemsSource="{Binding Items}"
                                                                      Margin="0,6,0,0"
                                                                      MinHeight="26">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:HomeworkItemViewModel}">
                                                                    <Grid Margin="0,3,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- 勾选框：点击切换完成状态。44x44 的透明命中区便于手指点击 -->
                                                                        <CheckBox Grid.Column="0"
                                                                                  IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,6,0"
                                                                                  Cursor="Hand"
                                                                                  Checked="ItemCheckBox_Changed"
                                                                                  Unchecked="ItemCheckBox_Changed">
                                                                            <CheckBox.Template>
                                                                                <ControlTemplate TargetType="CheckBox">
                                                                                    <!-- 外层透明 Border 是触摸命中区，保证手指点得住 -->
                                                                                    <Border Background="Transparent"
                                                                                            MinWidth="40"
                                                                                            MinHeight="40"
                                                                                            Padding="10">
                                                                                        <Border x:Name="Box"
                                                                                                Width="20"
                                                                                                Height="20"
                                                                                                CornerRadius="5"
                                                                                                BorderThickness="1.5"
                                                                                                BorderBrush="#636366"
                                                                                                Background="Transparent"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center">
                                                                                            <TextBlock x:Name="Tick"
                                                                                                       Text="✓"
                                                                                                       FontSize="13"
                                                                                                       FontWeight="Bold"
                                                                                                       Foreground="White"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"
                                                                                                       Visibility="Collapsed" />
                                                                                        </Border>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsChecked" Value="True">
                                                                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushSuccess}" />
                                                                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                                                                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </CheckBox.Template>
                                                                        </CheckBox>

                                                                        <!-- 内容文本：字号由设置控制，大字号便于教室大屏阅读。
                                                                             点击文字同样可切换完成状态，手指不容易点偏。 -->
                                                                        <Border Grid.Column="1"
                                                                                Background="Transparent"
                                                                                MinHeight="40"
                                                                                VerticalAlignment="Center"
                                                                                Cursor="Hand"
                                                                                MouseLeftButtonUp="ItemTextArea_MouseLeftButtonUp"
                                                                                TouchUp="ItemTextArea_TouchUp">
                                                                            <TextBlock x:Name="ContentText"
                                                                                       Text="{Binding DisplayContent}"
                                                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       TextWrapping="Wrap"
                                                                                       VerticalAlignment="Center"
                                                                                       Padding="0,8" />
                                                                        </Border>

                                                                        <!-- 编辑 / 删除 -->
                                                                        <StackPanel Grid.Column="2"
                                                                                    Orientation="Horizontal"
                                                                                    Margin="6,0,0,0">
                                                                            <Button Style="{StaticResource GhostIconButton}"
                                                                                    Content="✎"
                                                                                    Tag="{Binding}"
                                                                                    Click="BtnEditItem_Click"
                                                                                    ToolTip="编辑这条作业" />
                                                                            <Button Style="{StaticResource GhostIconButton}"
                                                                                    Content="✕"
                                                                                    Tag="{Binding}"
                                                                                    Click="BtnDeleteItem_Click"
                                                                                    ToolTip="删除这条作业" />
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <DataTemplate.Triggers>
                                                                        <!-- 已完成：文字变暗并加删除线 -->
                                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                                            <Setter TargetName="ContentText" Property="Foreground" Value="{StaticResource BrushTextDone}" />
                                                                            <Setter TargetName="ContentText" Property="TextDecorations" Value="Strikethrough" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 空科目占位提示：替代条目列表的位置，
                                                             点右边的 ＋ 即可开始添加。
                                                             字号强制取「正文字号 × 0.8」并显式设行高，
                                                             目的是让空卡片明显比有作业的卡片矮（折叠效果），
                                                             同时不随正文字号变大而变得臃肿。 -->
                                                        <TextBlock x:Name="EmptyPlaceholder"
                                                                   Text="暂无作业 · 点 ＋ 添加"
                                                                   Foreground="{StaticResource BrushTextTertiary}"
                                                                   FontSize="{Binding DataContext.EmptyHintFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   LineHeight="{Binding DataContext.EmptyHintLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Opacity="0.55"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border.Style>
                                                    <!-- 空科目卡片整体淡化：背景更暗，与有作业的卡片形成层次 -->
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Background" Value="#1F1F22" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <!-- 空科目：隐藏条目列表（它本来就是空的），
                                                     改为显示占位提示文字。
                                                     注意：光隐藏还不够——ItemsControl 自带 MinHeight=26 与 Margin=0,6,0,0，
                                                     会在标题和占位文字之间留出一段空白，这正是「科目名和暂无作业之间空隙很大」的根因。
                                                     因此这里把它整个收起来（Visibility=Collapsed），让占位文字紧贴标题行。 -->
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter TargetName="ItemsList" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="EmptyPlaceholder" Property="Visibility" Value="Visible" />
                                                    <!-- 折叠：卡片内边距收到最紧（上下各 4/5），
                                                         占位文字自身不留上边距，让「暂无作业」紧贴科目名下方 -->
                                                    <Setter TargetName="CardContent" Property="Margin" Value="12,3,10,4" />
                                                    <Setter TargetName="CardBorder" Property="Margin" Value="0,0,10,6" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 极端空状态：一个启用科目都没有（全部 enabled=false 或配置损坏）。
                     正常使用不会走到这里——空科目会常驻显示卡片。
                     这里提示用户去检查配置。 -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.001"
                              Padding="10"
                              Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    <StackPanel MinWidth="280" VerticalAlignment="Center" Margin="0,40,0,40">
                        <TextBlock Text="📋"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5" />
                        <TextBlock Text="没有可用的科目"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="所有科目都被禁用了。请点工具条的 📂 打开程序文件夹，用记事本编辑 settings.json，把想显示的科目里的 &quot;enabled&quot; 改成 true，保存后点 ↻ 重新载入。"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="4,0,4,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============================================================
                 第 3 行：状态栏
                 作用：① 温和提示保存结果、容错信息；② 提供右键缩放握把
                 ============================================================ -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="0,1,0,0"
                    Padding="14,6"
                    Background="#1A1A1C"
                    CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusBlock"
                               Grid.Column="0"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource BrushTextTertiary}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- ============================================================
                         缩放视觉提示（右下角三条斜线）
                         
                         注意：这**不是**交互控件，只是视觉提示。
                         实际缩放由代码后置在 RootLayout 上注册的 8 个透明热区完成
                         （四边 8px、四角 14x14，见 MainWindow.xaml.cs 的 InstallResizeHotspots）。
                         所以这里设 IsHitTestVisible="False"，
                         让鼠标/手指事件穿透到下层热区，用户拖这个角就是拖系统热区。
                         ============================================================ -->
                    <Viewbox x:Name="ResizeGrip"
                             Grid.Column="1"
                             Width="13"
                             Height="13"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             ToolTip="拖动窗口边缘或右下角可调整大小">
                        <Canvas Width="13" Height="13">
                            <Line X1="12" Y1="2" X2="2" Y2="12"
                                  Stroke="#8E8E93" StrokeThickness="1.2" Opacity="0.75" />
                            <Line X1="12" Y1="6" X2="6" Y2="12"
                                  Stroke="#8E8E93" StrokeThickness="1.2" Opacity="0.75" />
                            <Line X1="12" Y1="10" X2="10" Y2="12"
                                  Stroke="#8E8E93" StrokeThickness="1.2" Opacity="0.75" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
