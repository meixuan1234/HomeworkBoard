<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:HomeworkBoard.Converters">

    <!-- ============================================================================
         转换器注册
         ============================================================================ -->
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

    <!-- ============================================================================
         色板 —— Apple 暗黑模式（基于 iOS/macOS Dark Mode 的中性灰阶）
         设计原则：不用纯黑（#000），而用 #1C1C1E 一类的深灰，减少在教室大屏上的
                   泛白与刺眼；文字用 #F2F2F7 而非纯白，降低长时间注视的疲劳。
         ============================================================================ -->

    <!-- 窗口背景：深灰，带轻微透明（透明值由窗口 Opacity 单独控制） -->
    <Color x:Key="ColorWindowBg">#1C1C1E</Color>
    <SolidColorBrush x:Key="BrushWindowBg" Color="#1C1C1E" />

    <!-- 卡片背景：比窗口亮一档，形成层次 -->
    <SolidColorBrush x:Key="BrushCardBg" Color="#26262A" />
    <SolidColorBrush x:Key="BrushCardBgHover" Color="#2E2E33" />

    <!-- 分隔线 -->
    <SolidColorBrush x:Key="BrushSeparator" Color="#3A3A3C" />

    <!-- 文字层级 -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F2F2F7" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#AEAEB2" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="#8E8E93" />
    <SolidColorBrush x:Key="BrushTextDone" Color="#636366" />

    <!-- 强调色（Apple 系统蓝） -->
    <SolidColorBrush x:Key="BrushAccent" Color="#0A84FF" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#3D9BFF" />

    <!-- 功能色 -->
    <SolidColorBrush x:Key="BrushDanger" Color="#FF453A" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#30D158" />
    <SolidColorBrush x:Key="BrushWarning" Color="#FF9F0A" />

    <!-- 标题栏按钮悬停背景 -->
    <SolidColorBrush x:Key="BrushTitleBtnHover" Color="#3A3A3C" />
    <SolidColorBrush x:Key="BrushTitleBtnCloseHover" Color="#FF453A" />

    <!-- 输入框 -->
    <SolidColorBrush x:Key="BrushInputBg" Color="#1C1C1E" />
    <SolidColorBrush x:Key="BrushInputBorder" Color="#48484A" />
    <SolidColorBrush x:Key="BrushInputBorderFocus" Color="#0A84FF" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="BrushScrollThumb" Color="#48484A" />
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#636366" />
    <SolidColorBrush x:Key="BrushScrollTrack" Color="Transparent" />

    <!-- ============================================================================
         全局默认样式
         ============================================================================ -->

    <!-- 全局字体：微软雅黑（Win10 自带），等线作为备用；禁止使用需额外安装的字体 -->
    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>

    <!-- 滚动条样式：极细的自绘滚动条，符合 Apple 审美，且不占额外空间 -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{StaticResource BrushScrollThumb}"
                                                    CornerRadius="4"
                                                    Margin="1,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="{StaticResource BrushScrollThumbHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏图标按钮基础样式：扁平、无边框、悬停微亮。
         尺寸按触摸友好设定：36x34 内容区 + 圆角，满足手指点击精度要求。 -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTitleBtnHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsStylusOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTitleBtnHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮样式：悬停变红 -->
    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTitleBtnCloseHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮（卡片里的 ＋、✎、✕）。
         尺寸放大到 34x34，触摸时手指可准确命中，不会误触相邻按钮。 -->
    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A3A3C" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsStylusOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A3A3C" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 实心主按钮（对话框的「确定」）。触摸友好：最小高度 42。 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsStylusOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮（对话框的「取消」）。同样放大到触摸友好尺寸。 -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#3A3A3C" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#48484A" />
                        </Trigger>
                        <Trigger Property="IsStylusOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#48484A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 模板快选胶囊按钮。触摸场景下加高加宽，减少误触。 -->
    <Style x:Key="TemplateChip" TargetType="Button">
        <Setter Property="Background" Value="#3A3A3C" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsStylusOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 空状态里的科目选择按钮。
         比普通标签更醒目：带边框、更大内边距，触摸时容易命中。 -->
    <Style x:Key="SubjectPickChip" TargetType="Button">
        <Setter Property="Background" Value="#26262A" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="#48484A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            MinHeight="{TemplateBinding MinHeight}"
                            MinWidth="{TemplateBinding MinWidth}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2E2E33" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsStylusOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2E2E33" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑块样式：把默认的细长轨道换成粗轨道 + 大圆形拇指，
         手指在触摸屏上更容易抓住。 -->
    <Style x:Key="TouchSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" MinHeight="{TemplateBinding MinHeight}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 轨道：8px 高，触摸时容易看清位置 -->
                        <Border Height="8"
                                CornerRadius="4"
                                Background="#3A3A3C"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0" />
                        <!-- 已选区间填充 + 可拖拽拇指 -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="26" Height="26">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <!-- 外圈白边 + 内圈强调色，视觉上更醒目 -->
                                                <Ellipse Fill="White" Width="26" Height="26" />
                                                <Ellipse Fill="{StaticResource BrushAccent}" Width="20" Height="20" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 暗色输入框 -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBg}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushInputBorderFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 悬停显示提示的 ToolTip 样式 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#2E2E33" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="#48484A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="HasDropShadow" Value="False" />
    </Style>

</ResourceDictionary>
